{
  "name": "spacios-front",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint-eslint": "eslint \"src/**/*.ts\" \"./src/**/*.html\"",
    "lint-prettier": "prettier --check .",
    "lint": "npm run lint-eslint && npm run lint-prettier",
    "format": "prettier --write . && eslint --fix ",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "prepare": "husky install"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run format && npm run lint"
    }
  },
  "private": true,
  "dependencies": {
    "@abacritt/angularx-social-login": "~2.5.0",
    "@angular-eslint/eslint-plugin": "~20.7.0",
    "@angular-eslint/eslint-plugin-template": "~20.7.0",
    "@angular-eslint/schematics": "~20.7.0",
    "@angular-eslint/template-parser": "~20.7.0",
    "@angular/animations": "~20.3.27",
    "@angular/cdk": "~20.2.14",
    "@angular/common": "~20.3.27",
    "@angular/compiler": "~20.3.27",
    "@angular/core": "~20.3.27",
    "@angular/forms": "~20.3.27",
    "@angular/material": "~20.2.14",
    "@angular/platform-browser": "~20.3.27",
    "@angular/platform-browser-dynamic": "~20.3.27",
    "@angular/router": "~20.3.27",
    "@fortawesome/fontawesome-free": "~6.4.0",
    "@typescript-eslint/eslint-plugin": "^8.2.0",
    "chart.js": "~4.4.0",
    "cypress": "~13.12.0",
    "dcerialize": "~3.6.8",
    "ng2-charts": "~9.0.0",
    "ngx-extended-pdf-viewer": "~28.1.0",
    "ngx-skeleton-loader": "~13.0.0",
    "rxjs": "~7.8.0",
    "tslib": "~2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^20.3.32",
    "@angular/cli": "~20.3.32",
    "@angular/compiler-cli": "~20.3.27",
    "@eslint/eslintrc": "3.3.6",
    "@eslint/js": "~9.39.0",
    "@types/jasmine": "~4.6.0",
    "eslint": "~9.39.0",
    "eslint-config-prettier": "~8.8.0",
    "eslint-plugin-import": "^2.32.0",
    "husky": "~8.0.0",
    "jasmine-core": "~5.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "prettier": "~2.8.8",
    "typescript": "~5.8.3"
  }
}
